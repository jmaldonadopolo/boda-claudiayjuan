---
import Layout from '../layouts/Layout.astro';
import albumMemories from '../data/gallery.json';
import DedicationWall from '../components/DedicationWall';

export const prerender = true;

const memories = [
	{ galleryIndex: 1, alt: 'Mamá y papá comparten una celebración en familia', year: '2008', note: 'En las cosas sencillas también caben los recuerdos más grandes.' },
	{ galleryIndex: 4, alt: 'Mamá y papá posan abrazados en la escalera', year: '2009', note: 'Una historia hecha de compañía, paciencia y muchas sonrisas.' },
	{ galleryIndex: 6, alt: 'Mamá y papá celebran una Navidad en familia', year: '2010', note: 'Cada celebración se vuelve un motivo para estar juntos.' },
	{ galleryIndex: 7, alt: 'Mamá y papá se abrazan durante una celebración', year: '2010', note: 'Al lado del otro, las risas siempre encuentran su lugar.' },
	{ galleryIndex: 11, alt: 'Mamá y papá comparten un momento en el jardín', year: '2016', note: 'Con los años, la ternura sigue encontrando nuevos gestos.' },
	{ galleryIndex: 15, alt: 'Mamá y papá de paseo juntos', year: '2016', note: 'También quedan los caminos que recorrieron juntos.' },
	{ galleryIndex: 19, alt: 'Mamá y papá comparten una comida', year: '2017', note: 'En cada etapa, el amor ha sido su mejor compañía.' },
	{ galleryIndex: 26, alt: 'Mamá y papá brindan durante una comida', year: '2019', note: 'Y las sobremesas, otra forma de decir: aquí estoy.' },
];
---

<Layout>
	<div class="paper-grain" aria-hidden="true"></div>
	<header class="topbar">
		<a class="monogram" href="#inicio" aria-label="Inicio">C <span class="couple-ampersand">&amp;</span> J</a>
		<a class="topbar-date" href="#celebracion">31 · 10 · 2026</a>
		<a class="topbar-link" href="#dedicatorias">Deja un mensaje <span aria-hidden="true">↗</span></a>
	</header>

	<main class="relative">
		<section class="hero" id="inicio" aria-labelledby="hero-title">
			<div class="hero-orbit orbit-one" aria-hidden="true"></div>
			<div class="hero-orbit orbit-two" aria-hidden="true"></div>
			<div class="hero-copy">
				<p class="eyebrow">Claudia & Juan · una historia de amor</p>
				<h1 id="hero-title">Después de tantos<br /><em>capítulos</em>, uno más.</h1>
				<p class="hero-description">Con el corazón lleno de gratitud, celebramos el amor de nuestros papás y queremos compartirlo contigo.</p>
				<div class="hero-countdown-wrap">
					<p class="countdown-label">FALTAN</p>
					<div class="countdown hero-countdown" role="timer" aria-label="Cuenta regresiva para la boda" data-countdown>
						<div><strong data-days>--</strong><span>días</span></div><i>:</i>
						<div><strong data-hours>--</strong><span>horas</span></div><i>:</i>
						<div><strong data-minutes>--</strong><span>minutos</span></div><i>:</i>
						<div><strong data-seconds>--</strong><span>segundos</span></div>
					</div>
					<p class="countdown-welcome" data-countdown-welcome role="status" aria-live="polite" hidden>Bienvenidos a nuestra boda</p>
				</div>
				<a class="text-link" href="#historia">Desliza para ver su historia <span aria-hidden="true">↓</span></a>
			</div>
			<div class="hero-portrait" aria-label="Retrato de los novios">
				<img src={albumMemories[2].thumb} width={albumMemories[2].thumbWidth} height={albumMemories[2].thumbHeight} alt="Mamá y papá juntos, sonriendo en el jardín" fetchpriority="high" decoding="async" />
				<div class="hero-photo-floral" aria-hidden="true"><img src="/images/curtain-florals.df41fe4ec3.webp" width="1312" height="1199" alt="" decoding="async" /></div>
				<div class="hero-photo-label"><span>Juntos, siempre</span><span>01 / 05</span></div>
			</div>
			<div class="hero-bottom"><span>CON TODO NUESTRO AMOR</span><span>UN DÍA PARA RECORDAR</span></div>
		</section>

		<section class="intro section-pad" id="historia" data-parallax-section>
			<div class="botanical-layer botanical-intro-side" data-flower-parallax data-parallax-distance="18" aria-hidden="true"><img src="/images/botanical-spray.77530ea63e.webp" width="1024" height="1536" alt="" loading="lazy" decoding="async" /></div>
			<div class="section-index" data-story-step>01 <i></i> SU HISTORIA</div>
			<div class="intro-layout">
				<p class="intro-side" data-story-step>Un amor que<br />sigue creciendo</p>
				<div class="intro-main">
					<p class="eyebrow" data-story-step>Para quienes han sido nuestro hogar</p>
					<h2 data-story-step>Hay historias que<br />merecen <em>celebrarse</em><br />una y otra vez.</h2>
					<p data-story-step>Entre días cotidianos, encuentros y celebraciones, mamá y papá han construido una vida llena de momentos compartidos. Este octubre, nos reunimos para acompañarlos en una promesa nueva.</p>
				</div>
				<img class="intro-flower" src="/images/botanical-spray.77530ea63e.webp" width="1024" height="1536" alt="" aria-hidden="true" loading="lazy" decoding="async" data-flower-parallax data-parallax-distance="30" />
			</div>
		</section>

		<section class="memories section-pad" id="recuerdos" aria-labelledby="memories-title" data-parallax-section>
			<div class="botanical-layer botanical-memories-left" data-flower-parallax data-parallax-distance="26" aria-hidden="true"><img src="/images/botanical-spray.77530ea63e.webp" width="1024" height="1536" alt="" loading="lazy" decoding="async" /></div>
			<div class="botanical-layer botanical-memories-right" data-flower-parallax data-parallax-distance="18" aria-hidden="true"><img src="/images/botanical-spray.77530ea63e.webp" width="1024" height="1536" alt="" loading="lazy" decoding="async" /></div>
			<div class="section-index" data-story-step>02 <i></i> RECUERDOS</div>
			<div class="memories-heading">
				<p class="eyebrow" data-story-step>Pequeños instantes, toda una vida</p>
				<h2 id="memories-title" data-story-step>Lo bonito de llegar<br />hasta <em>aquí.</em></h2>
			</div>
			<div class="polaroid-field">
				{memories.map((memory, index) => (
					<figure class={`polaroid polaroid-${index + 1}`} data-card data-gallery-index={memory.galleryIndex} data-gallery-year={memory.year} tabindex="0" role="button" aria-label={`Abrir recuerdo ${index + 1}: ${memory.note}`}>
						<div class="photo-wrap"><img src={albumMemories[memory.galleryIndex].thumb} width={albumMemories[memory.galleryIndex].thumbWidth} height={albumMemories[memory.galleryIndex].thumbHeight} alt={memory.alt} loading="lazy" decoding="async" /></div>
						<figcaption>
							<span class="photo-year">{memory.year}</span>
							<span class="photo-note">{memory.note}</span>
						</figcaption>
						<span class="tape" aria-hidden="true"></span>
					</figure>
				))}
			</div>
			<div class="memory-quote"><span>“</span><p data-story-step>El mejor lugar siempre ha sido<br />a donde vamos juntos.</p><i data-story-step>UNA HISTORIA QUE CONTINÚA</i></div>
			<button class="album-link" type="button" data-gallery-open-all aria-controls="wedding-gallery" data-story-step>Ver el álbum completo <span aria-hidden="true">↗</span></button>
		</section>

		<section class="celebration" id="celebracion" aria-labelledby="celebration-title" data-parallax-section>
			<div class="botanical-layer botanical-celebration-side" data-flower-parallax data-parallax-distance="18" aria-hidden="true"><img src="/images/botanical-spray.77530ea63e.webp" width="1024" height="1536" alt="" loading="lazy" decoding="async" /></div>
			<div class="celebration-text">
				<div class="section-index light" data-story-step>03 <i></i> SU PROMESA</div>
				<p class="eyebrow" data-story-step>Ante el altar</p>
				<h2 id="celebration-title" data-story-step>Un sí que recoge<br />toda una <em>historia.</em></h2>
				<p data-story-step>Claudia y Juan celebrarán ante Dios el amor que han cuidado día a día, y harán de su historia una promesa para toda la vida.</p>
				<blockquote class="scripture-quote" data-story-step><p>«Muchos son los planes en el corazón del hombre, pero el propósito del Señor es el que prevalece».</p><cite>Proverbios 19:21</cite></blockquote>
				<a class="calendar-link" href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Boda%20de%20Claudia%20y%20Juan&dates=20261031/20261101&details=Una%20celebraci%C3%B3n%20para%20acompa%C3%B1ar%20a%20Claudia%20y%20Juan%20ante%20el%20altar.&ctz=America%2FBogota" target="_blank" rel="noreferrer" data-story-step>Guardar la fecha · 31 de octubre <span aria-hidden="true">↗</span></a>
			</div>
			<div class="celebration-art">
				<figure class="celebration-photo" data-story-photo>
					<img src={albumMemories[0].image} width={albumMemories[0].width} height={albumMemories[0].height} alt="Claudia y Juan de la mano, vestidos elegantemente" loading="lazy" decoding="async" />
					<div class="celebration-photo-floral" aria-hidden="true"><img src="/images/curtain-florals.df41fe4ec3.webp" width="1312" height="1199" alt="" loading="lazy" decoding="async" /></div>
					<figcaption>Un amor que nos inspira</figcaption>
				</figure>
				<div class="art-flower flower-a" aria-hidden="true">✳</div>
				<div class="art-script" aria-hidden="true">para siempre</div>
			</div>
		</section>

		<section class="guestbook section-pad" id="dedicatorias" aria-labelledby="guestbook-title" data-parallax-section>
			<div class="botanical-layer botanical-guestbook-side" data-flower-parallax data-parallax-distance="22" aria-hidden="true"><img src="/images/botanical-spray.77530ea63e.webp" width="1024" height="1536" alt="" loading="lazy" decoding="async" /></div>
			<div class="section-index" data-story-step>04 <i></i> LIBRO DE FIRMAS</div>
			<DedicationWall client:visible />
		</section>
	</main>
	<button class="floating-envelope" type="button" data-floating-envelope aria-label="Arrastra o pulsa para ir a las dedicatorias">
		<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="5" y="10" width="38" height="28" rx="5" fill="currentColor"/><path d="m7 14 17 13 17-13M8 35l12-10m20 10L28 25" fill="none" stroke="#fff5e8" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"/><path d="M24 28.5s-6.8-4.8-6.8-8.7a3.8 3.8 0 0 1 6.8-2.3 3.8 3.8 0 0 1 6.8 2.3c0 3.9-6.8 8.7-6.8 8.7Z" fill="#741a36" stroke="#f6eee1" stroke-width=".8" stroke-linejoin="round"/></svg>
		<span>Dedicatorias</span>
	</button>

	<footer class="footer">
		<div class="footer-mark" data-story-step>C <span class="couple-ampersand">&amp;</span> J</div>
		<p data-story-step>Un nuevo capítulo, rodeados de quienes más queremos.</p>
		<div class="footer-bottom" data-story-step><span>CON AMOR, LA FAMILIA</span><a href="#inicio">VOLVER ARRIBA ↑</a><span>31 · 10 · 2026</span></div>
		<p class="footer-location" data-story-step>Capilla · Parroquia Santa María Reina</p>
	</footer>

	<div class="curtain-intro" data-curtain role="dialog" aria-modal="true" aria-labelledby="invite-title" aria-label="Bienvenida a la invitación de boda">
		<div class="curtain-panel curtain-left"></div><div class="curtain-panel curtain-right"></div>
		<div class="curtain-center">
			<div class="curtain-monogram" id="invite-title">Claudia <span class="couple-ampersand">&amp;</span> Juan</div>
			<p>Una celebración de amor</p>
			<button type="button" data-open-invitation autofocus>CONOCE NUESTRA HISTORIA <span aria-hidden="true">↓</span></button>
			<small>31 DE OCTUBRE · 2026</small>
		</div>
		<div class="balloon balloon-one" aria-hidden="true"><i></i></div><div class="balloon balloon-two" aria-hidden="true"><i></i></div><div class="balloon balloon-three" aria-hidden="true"><i></i></div>
		<div class="balloon balloon-four" aria-hidden="true"><i></i></div><div class="balloon balloon-five" aria-hidden="true"><i></i></div><div class="balloon balloon-six" aria-hidden="true"><i></i></div>
		<div class="balloon balloon-seven" aria-hidden="true"><i></i></div><div class="balloon balloon-eight" aria-hidden="true"><i></i></div>
		<div class="curtain-floral curtain-floral-left" aria-hidden="true"><img src="/images/curtain-florals.df41fe4ec3.webp" width="1312" height="1199" alt="" /></div>
		<div class="curtain-floral curtain-floral-right" aria-hidden="true"><img src="/images/curtain-florals.df41fe4ec3.webp" width="1312" height="1199" alt="" /></div>
		<div class="curtain-footer"><span>UNA HISTORIA DE FAMILIA</span><span>DESLIZA, RECUERDA, CELEBRA</span></div>
	</div>
	<div class="page-floral page-floral-left" aria-hidden="true"><img src="/images/curtain-florals.df41fe4ec3.webp" width="1312" height="1199" alt="" /></div>
	<div class="page-floral page-floral-right" aria-hidden="true"><img src="/images/curtain-florals.df41fe4ec3.webp" width="1312" height="1199" alt="" /></div>

	<script type="application/json" data-gallery-data set:html={JSON.stringify(albumMemories)}></script>
	<dialog class="gallery-dialog" id="wedding-gallery" data-gallery-dialog aria-label="Galería de recuerdos de Claudia y Juan">
		<div class="gallery-frame">
			<button class="gallery-close" type="button" data-gallery-close aria-label="Cerrar galería">×</button>
			<button class="gallery-arrow gallery-prev" type="button" data-gallery-prev aria-label="Foto anterior">‹</button>
			<figure class="gallery-photo" data-gallery-photo>
				<img data-gallery-image alt="" decoding="async" />
				<figcaption><span class="gallery-count" data-gallery-count></span><p data-gallery-caption></p></figcaption>
			</figure>
			<button class="gallery-arrow gallery-next" type="button" data-gallery-next aria-label="Foto siguiente">›</button>
			<p class="gallery-hint">Usa las flechas o desliza para recorrer sus recuerdos</p>
		</div>
	</dialog>
</Layout>

<script>
	import gsap from 'gsap';
	import confetti from 'canvas-confetti';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import Lenis from 'lenis';

	gsap.registerPlugin(ScrollTrigger);

	const curtain = document.querySelector<HTMLElement>('[data-curtain]');
	const openButton = document.querySelector<HTMLButtonElement>('[data-open-invitation]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const floatingEnvelope = document.querySelector<HTMLButtonElement>('[data-floating-envelope]');
	const dedicationTarget = document.querySelector<HTMLElement>('#dedicatorias');
	if (floatingEnvelope && dedicationTarget) {
		let pointerStartY: number | null = null;
		let dragged = false;
		const goToDedications = () => dedicationTarget.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
		floatingEnvelope.addEventListener('pointerdown', (event) => {
			pointerStartY = event.clientY;
			dragged = false;
			floatingEnvelope.setPointerCapture(event.pointerId);
		});
		floatingEnvelope.addEventListener('pointermove', (event) => {
			if (pointerStartY === null) return;
			const deltaY = event.clientY - pointerStartY;
			if (Math.abs(deltaY) > 8) {
				dragged = true;
				floatingEnvelope.classList.add('is-dragging');
				floatingEnvelope.style.setProperty('--drag-y', `${Math.max(-54, Math.min(54, deltaY))}px`);
			}
		});
		floatingEnvelope.addEventListener('pointerup', () => {
			pointerStartY = null;
			floatingEnvelope.classList.remove('is-dragging');
			window.setTimeout(() => floatingEnvelope.style.removeProperty('--drag-y'), 240);
			if (dragged) {
				floatingEnvelope.dataset.dragged = 'true';
				goToDedications();
				window.setTimeout(() => delete floatingEnvelope.dataset.dragged, 0);
			}
		});
		floatingEnvelope.addEventListener('pointercancel', () => { pointerStartY = null; floatingEnvelope.classList.remove('is-dragging'); });
		floatingEnvelope.addEventListener('click', (event) => {
			if (floatingEnvelope.dataset.dragged === 'true') { event.preventDefault(); return; }
			goToDedications();
		});
		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver(([entry]) => floatingEnvelope.classList.toggle('is-hidden', entry.isIntersecting), { threshold: .08 });
			observer.observe(dedicationTarget);
		} else {
			const updateEnvelopeVisibility = () => {
				const bounds = dedicationTarget.getBoundingClientRect();
				floatingEnvelope.classList.toggle('is-hidden', bounds.top < window.innerHeight && bounds.bottom > 0);
			};
			window.addEventListener('scroll', updateEnvelopeVisibility, { passive: true });
			window.addEventListener('resize', updateEnvelopeVisibility, { passive: true });
		}
	}
	let celebrationAudio: AudioContext | null = null;
	type WindowWithWebkitAudio = Window & { webkitAudioContext?: typeof AudioContext };
	const prepareCelebrationAudio = () => {
		try {
			const AudioContextConstructor = window.AudioContext ?? (window as WindowWithWebkitAudio).webkitAudioContext;
			if (!AudioContextConstructor) return;
			celebrationAudio ??= new AudioContextConstructor();
			// Crear y arrancar una fuente silenciosa dentro del clic desbloquea Web Audio
			// en navegadores que exigen un gesto explícito antes de reproducir sonido.
			const silentBuffer = celebrationAudio.createBuffer(1, 1, celebrationAudio.sampleRate);
			const silentSource = celebrationAudio.createBufferSource();
			silentSource.buffer = silentBuffer;
			silentSource.connect(celebrationAudio.destination);
			silentSource.start();
			if (celebrationAudio.state !== 'running') void celebrationAudio.resume().catch(() => undefined);
		} catch { /* El confeti visual sigue disponible si el navegador no ofrece Web Audio. */ }
	};
	const playCelebrationSound = () => {
		const context = celebrationAudio;
		if (!context) return;
		const play = () => {
			try {
				const now = context.currentTime;
				const tailDuration = .72;
				const master = context.createGain();
				master.gain.setValueAtTime(.38, now);
				master.connect(context.destination);

				const noiseBuffer = context.createBuffer(1, Math.ceil(context.sampleRate * tailDuration), context.sampleRate);
				const noiseSamples = noiseBuffer.getChannelData(0);
				for (let index = 0; index < noiseSamples.length; index += 1) noiseSamples[index] = Math.random() * 2 - 1;

				// Golpe grave breve y un chasquido agudo dan el carácter de petardo de fiesta.
				const thump = context.createOscillator();
				const thumpFilter = context.createBiquadFilter();
				const thumpVolume = context.createGain();
				thump.type = 'sine';
				thump.frequency.setValueAtTime(125, now);
				thump.frequency.exponentialRampToValueAtTime(48, now + .16);
				thumpFilter.type = 'lowpass';
				thumpFilter.frequency.setValueAtTime(320, now);
				thumpVolume.gain.setValueAtTime(.0001, now);
				thumpVolume.gain.linearRampToValueAtTime(.85, now + .004);
				thumpVolume.gain.exponentialRampToValueAtTime(.0001, now + .19);
				thump.connect(thumpFilter).connect(thumpVolume).connect(master);
				thump.start(now);
				thump.stop(now + .2);

				const crack = context.createBufferSource();
				const crackFilter = context.createBiquadFilter();
				const crackVolume = context.createGain();
				crack.buffer = noiseBuffer;
				crackFilter.type = 'highpass';
				crackFilter.frequency.setValueAtTime(700, now);
				crackVolume.gain.setValueAtTime(.0001, now);
				crackVolume.gain.linearRampToValueAtTime(.9, now + .002);
				crackVolume.gain.exponentialRampToValueAtTime(.0001, now + .075);
				crack.connect(crackFilter).connect(crackVolume).connect(master);
				crack.start(now);
				crack.stop(now + .08);

				// Chisporroteo irregular, como el papel metalizado de un cañón de fiesta.
				const fizz = context.createBufferSource();
				const fizzFilter = context.createBiquadFilter();
				const fizzVolume = context.createGain();
				fizz.buffer = noiseBuffer;
				fizzFilter.type = 'lowpass';
				fizzFilter.frequency.setValueAtTime(5200, now);
				fizzVolume.gain.setValueAtTime(.32, now + .018);
				fizzVolume.gain.exponentialRampToValueAtTime(.0001, now + tailDuration);
				fizz.connect(fizzFilter).connect(fizzVolume).connect(master);
				fizz.start(now + .018);
				fizz.stop(now + tailDuration);

				for (let index = 0; index < 13; index += 1) {
					const start = now + .055 + Math.random() * .5;
					const duration = .018 + Math.random() * .035;
					const snap = context.createBufferSource();
					const snapFilter = context.createBiquadFilter();
					const snapVolume = context.createGain();
					snap.buffer = noiseBuffer;
					snapFilter.type = 'bandpass';
					snapFilter.frequency.setValueAtTime(1300 + Math.random() * 3600, start);
					snapFilter.Q.setValueAtTime(.7 + Math.random() * 1.4, start);
					snapVolume.gain.setValueAtTime(.0001, start);
					snapVolume.gain.linearRampToValueAtTime(.65, start + .0015);
					snapVolume.gain.exponentialRampToValueAtTime(.0001, start + duration);
					snap.connect(snapFilter).connect(snapVolume).connect(master);
					snap.start(start);
					snap.stop(start + duration);
				}
				window.setTimeout(() => master.disconnect(), 1100);
			} catch { /* Algunos dispositivos pueden suspender el audio al cambiar de pestaña. */ }
		};
		if (context.state === 'running') play();
		else void context.resume().then(play).catch(() => undefined);
	};
	type GalleryMemory = { image: string; thumb: string; width: number; height: number; alt: string; year: string; note: string };
	const galleryMemories = JSON.parse(document.querySelector<HTMLScriptElement>('[data-gallery-data]')?.textContent ?? '[]') as GalleryMemory[];
	let celebrationBurstPlayed = false;
	const celebrateAfterCurtainOpens = () => {
		if (celebrationBurstPlayed) return;
		celebrationBurstPlayed = true;
		playCelebrationSound();
		if (reducedMotion) return;

		const themeColors = ['#662536', '#4a1728', '#b8875b', '#d8b58b', '#f3ecdf'];
		confetti({ particleCount: 108, spread: 78, startVelocity: 43, gravity: .82, decay: .9, ticks: 220, scalar: .92, origin: { x: .5, y: .88 }, colors: themeColors, shapes: ['square', 'circle'], zIndex: 120 });
		window.setTimeout(() => {
			confetti({ particleCount: 34, angle: 62, spread: 58, startVelocity: 38, gravity: .86, decay: .9, ticks: 210, scalar: .82, origin: { x: 0, y: .9 }, colors: themeColors, zIndex: 120 });
			confetti({ particleCount: 34, angle: 118, spread: 58, startVelocity: 38, gravity: .86, decay: .9, ticks: 210, scalar: .82, origin: { x: 1, y: .9 }, colors: themeColors, zIndex: 120 });
		}, 140);
	};

	if (curtain && openButton) {
		document.body.classList.add('is-locked');
		openButton.addEventListener('click', () => {
			prepareCelebrationAudio();
			curtain.classList.add('is-opening');
			document.body.classList.remove('is-locked');
			document.body.classList.add('is-open');
			const previousScrollBehavior = document.documentElement.style.scrollBehavior;
			document.documentElement.style.scrollBehavior = 'auto';
			window.scrollTo(0, 0);
			if (window.location.hash) window.history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
			window.setTimeout(() => { document.documentElement.style.scrollBehavior = previousScrollBehavior; }, 1800);
			const curtainPanels = [...curtain.querySelectorAll<HTMLElement>('.curtain-panel')];
			if (reducedMotion || curtainPanels.length < 2) {
				window.setTimeout(celebrateAfterCurtainOpens, 40);
			} else {
				const openedPanels = new Set<HTMLElement>();
				const onPanelOpened = (event: TransitionEvent) => {
					if (event.propertyName !== 'transform' || !curtainPanels.includes(event.currentTarget as HTMLElement)) return;
					openedPanels.add(event.currentTarget as HTMLElement);
					if (openedPanels.size === curtainPanels.length) celebrateAfterCurtainOpens();
				};
				curtainPanels.forEach((panel) => panel.addEventListener('transitionend', onPanelOpened));
				window.setTimeout(celebrateAfterCurtainOpens, 1500);
			}
			if (!reducedMotion) {
				const entrance = gsap.timeline();
				entrance.fromTo('.hero-copy > *:not(.hero-countdown-wrap)', { autoAlpha: 0, y: 18 }, {
					autoAlpha: 1, y: 0, duration: 0.52, stagger: 0.075, ease: 'power2.out',
				}, 0.12);
				entrance.fromTo('.hero-countdown-wrap', { autoAlpha: 0, y: 14 }, {
					autoAlpha: 1, y: 0, duration: 0.55, ease: 'power2.out',
				}, 0.32);
				entrance.fromTo('.hero-portrait', { autoAlpha: 0, y: 24, rotate: 4 }, {
					autoAlpha: 1, y: 0, rotate: 1.8, duration: 0.72, ease: 'power2.out',
				}, 0.12);
				entrance.fromTo('.hero-photo-floral', { autoAlpha: 0, scale: 0.92 }, {
					autoAlpha: 1, scale: 1, duration: 0.55, ease: 'power2.out',
				}, 0.4);
			}
			window.setTimeout(() => {
				curtain.remove();
				requestAnimationFrame(() => ScrollTrigger.refresh());
			}, reducedMotion ? 40 : 1500);
		});
	}

	if (!reducedMotion) {
		if (typeof window.requestAnimationFrame === 'function') {
			try {
				const lenis = new Lenis({ duration: 1.25, smoothWheel: true, syncTouch: false, wheelMultiplier: 0.82, anchors: { offset: -76 } });
				lenis.on('scroll', ScrollTrigger.update);
				gsap.ticker.add((time) => lenis.raf(time * 1000));
				gsap.ticker.lagSmoothing(0);
			} catch (error) {
				console.warn('Lenis no está disponible; se conserva el desplazamiento nativo del navegador.', error);
			}
		}

		gsap.utils.toArray<HTMLElement>('[data-story-step]').forEach((element) => {
			gsap.fromTo(element, { autoAlpha: 0, y: 24 }, {
				autoAlpha: 1, y: 0, duration: 0.78, ease: 'power2.out',
				scrollTrigger: { trigger: element, start: 'top 88%', once: true },
			});
		});
		const altarPhoto = document.querySelector<HTMLElement>('[data-story-photo]');
		if (altarPhoto) gsap.fromTo(altarPhoto, { autoAlpha: 0, y: 34, rotation: -5, rotationY: -8, scale: 0.96, transformPerspective: 1100 }, {
			autoAlpha: 1, y: 0, rotation: 2, rotationY: 0, scale: 1, duration: 1.05, ease: 'power3.out',
			scrollTrigger: { trigger: altarPhoto, start: 'top 82%', once: true },
		});
		gsap.utils.toArray<HTMLElement>('[data-flower-parallax]').forEach((element, index) => {
			const section = element.closest<HTMLElement>('[data-parallax-section]');
			if (!section) return;
			const distance = Number(element.dataset.parallaxDistance) || 34;
			const startY = index % 2 === 0 ? distance : -distance;
			gsap.fromTo(element, { y: startY }, {
				y: -startY, ease: 'none',
				scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 1 },
			});
		});

		gsap.utils.toArray<HTMLElement>('[data-card]').forEach((card, index) => {
			const tilt = [-8, 5, 8, 6, -7, 4, -6, 6][index] ?? 0;
			const liftCard = () => gsap.to(card, { y: -12, rotate: tilt + (index % 2 ? -2 : 2), scale: 1.035, duration: 0.32, ease: 'power2.out', overwrite: true });
			const settleCard = () => gsap.to(card, { y: 0, rotate: tilt, scale: 1, duration: 0.42, ease: 'power2.out', overwrite: true });
			card.addEventListener('pointerenter', liftCard);
			card.addEventListener('pointerleave', settleCard);
			card.addEventListener('focus', liftCard);
			card.addEventListener('blur', settleCard);
			gsap.fromTo(card, { autoAlpha: 0, y: 62, rotate: tilt + (index % 2 ? -12 : 12), rotationY: index % 2 ? 8 : -8, transformPerspective: 900, scale: 0.97 }, {
				autoAlpha: 1, y: 0, rotate: tilt, rotationY: 0, scale: 1, duration: 1.05,
				ease: 'power3.out', scrollTrigger: { trigger: card, start: 'top 88%', once: true },
			});
		});
	}

	const gallery = document.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
	const galleryImage = gallery?.querySelector<HTMLImageElement>('[data-gallery-image]');
	const galleryPhoto = gallery?.querySelector<HTMLElement>('[data-gallery-photo]');
	const galleryCaption = gallery?.querySelector<HTMLElement>('[data-gallery-caption]');
	const galleryCount = gallery?.querySelector<HTMLElement>('[data-gallery-count]');
	let activePhoto = 0;
	let swipeStartX = 0;
	let galleryClosing = false;
	let photoLoadSequence = 0;
	const preloadedPhotos = new Set<string>();
	const preloadGalleryPhoto = (index: number) => {
		if (!galleryMemories.length) return;
		const imageUrl = galleryMemories[(index + galleryMemories.length) % galleryMemories.length].image;
		if (preloadedPhotos.has(imageUrl)) return;
		const preload = new Image();
		preload.decoding = 'async';
		preload.src = imageUrl;
		preloadedPhotos.add(imageUrl);
	};
	const paintGalleryPhoto = (index: number, direction = 1) => {
		if (!gallery || !galleryImage || !galleryCaption || !galleryCount || !galleryMemories.length) return;
		activePhoto = (index + galleryMemories.length) % galleryMemories.length;
		const memory = galleryMemories[activePhoto];
		const loadSequence = ++photoLoadSequence;
		galleryImage.dataset.loading = 'true';
		galleryImage.width = memory.width;
		galleryImage.height = memory.height;
		galleryImage.onload = () => {
			if (loadSequence !== photoLoadSequence) return;
			delete galleryImage.dataset.loading;
			if (!reducedMotion) gsap.fromTo(galleryImage, { autoAlpha: 0, rotateY: direction * 18, scale: 0.97 }, { autoAlpha: 1, rotateY: 0, scale: 1, duration: 0.42, ease: 'power2.out', overwrite: true });
		};
		galleryImage.onerror = () => { if (loadSequence === photoLoadSequence) delete galleryImage.dataset.loading; };
		galleryImage.src = memory.image;
		galleryImage.alt = memory.alt;
		galleryCaption.textContent = memory.note;
		galleryCount.textContent = `RECUERDO ${String(activePhoto + 1).padStart(2, '0')} / ${String(galleryMemories.length).padStart(2, '0')}`;
		preloadGalleryPhoto(activePhoto + 1);
		preloadGalleryPhoto(activePhoto - 1);
	};
	const closeGallery = () => {
		if (!gallery?.open || galleryClosing) return;
		if (reducedMotion) { gallery.close(); return; }
		galleryClosing = true;
		gsap.killTweensOf(gallery);
		gsap.to(gallery, {
			autoAlpha: 0, y: 10, scale: 0.99, '--gallery-backdrop': 0,
			duration: 0.28, ease: 'power2.in',
			onComplete: () => {
				gallery.close();
				gsap.set(gallery, { clearProps: 'opacity,visibility,transform' });
				gallery.style.removeProperty('--gallery-backdrop');
				galleryClosing = false;
			},
		} as gsap.TweenVars);
	};
	const openGalleryAt = (index: number) => {
		if (!gallery || gallery.open) return;
		paintGalleryPhoto(index);
		galleryClosing = false;
		gallery.style.setProperty('--gallery-backdrop', '0');
		gallery.showModal();
		document.body.classList.add('gallery-open');
		if (!reducedMotion) {
			gsap.fromTo(gallery, { autoAlpha: 0, y: 12, scale: 0.99 }, {
				autoAlpha: 1, y: 0, scale: 1, '--gallery-backdrop': 1,
				duration: 0.42, ease: 'power2.out', overwrite: true,
			} as gsap.TweenVars);
		}
	};
	document.querySelectorAll<HTMLElement>('[data-gallery-index]').forEach((card) => {
		const open = () => openGalleryAt(Number(card.dataset.galleryIndex ?? 0));
		card.addEventListener('click', open);
		card.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); }
		});
	});
	document.querySelector<HTMLButtonElement>('[data-gallery-open-all]')?.addEventListener('click', () => {
		openGalleryAt(0);
	});
	gallery?.querySelector('[data-gallery-close]')?.addEventListener('click', closeGallery);
	gallery?.querySelector('[data-gallery-prev]')?.addEventListener('click', () => paintGalleryPhoto(activePhoto - 1, -1));
	gallery?.querySelector('[data-gallery-next]')?.addEventListener('click', () => paintGalleryPhoto(activePhoto + 1, 1));
	gallery?.addEventListener('click', (event) => { if (event.target === gallery) closeGallery(); });
	gallery?.addEventListener('cancel', (event) => { event.preventDefault(); closeGallery(); });
	gallery?.addEventListener('close', () => { document.body.classList.remove('gallery-open'); galleryClosing = false; });
	galleryPhoto?.addEventListener('pointerdown', (event) => { swipeStartX = event.clientX; });
	galleryPhoto?.addEventListener('pointerup', (event) => {
		const distance = event.clientX - swipeStartX;
		if (Math.abs(distance) > 55) paintGalleryPhoto(activePhoto + (distance < 0 ? 1 : -1), distance < 0 ? 1 : -1);
	});
	document.addEventListener('keydown', (event) => {
		if (!gallery?.open) return;
		if (event.key === 'ArrowRight') paintGalleryPhoto(activePhoto + 1, 1);
		if (event.key === 'ArrowLeft') paintGalleryPhoto(activePhoto - 1, -1);
	});

	const weddingDate = new Date('2026-10-31T00:00:00-05:00').getTime();
	const countdown = document.querySelector<HTMLElement>('[data-countdown]');
	const countdownLabel = document.querySelector<HTMLElement>('.countdown-label');
	const countdownWelcome = document.querySelector<HTMLElement>('[data-countdown-welcome]');
	const setCountdown = () => {
		const remaining = weddingDate - Date.now();
		if (!countdown) return;
		const days = countdown.querySelector<HTMLElement>('[data-days]');
		const hours = countdown.querySelector<HTMLElement>('[data-hours]');
		const minutes = countdown.querySelector<HTMLElement>('[data-minutes]');
		const seconds = countdown.querySelector<HTMLElement>('[data-seconds]');
		if (remaining <= 0) {
			countdown.hidden = true;
			if (countdownLabel) countdownLabel.hidden = true;
			if (countdownWelcome) countdownWelcome.hidden = false;
			return;
		}
		if (days) days.textContent = String(Math.floor(remaining / 86_400_000)).padStart(2, '0');
		if (hours) hours.textContent = String(Math.floor((remaining % 86_400_000) / 3_600_000)).padStart(2, '0');
		if (minutes) minutes.textContent = String(Math.floor((remaining % 3_600_000) / 60_000)).padStart(2, '0');
		if (seconds) seconds.textContent = String(Math.floor((remaining % 60_000) / 1_000)).padStart(2, '0');
	};
	setCountdown();
	window.setInterval(setCountdown, 1000);

</script>

